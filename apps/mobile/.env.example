# Mobile app environment. Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app
# bundle - never put secrets (OpenAI keys, JWT secrets, etc.) here. The mobile app talks only to
# our own backend; the backend is the only thing that ever talks to OpenAI. See docs/environment.md.

# Android emulator reaches the host machine's localhost via 10.0.2.2, NOT localhost/127.0.0.1.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

EXPO_PUBLIC_APP_SCHEME=personalagent
