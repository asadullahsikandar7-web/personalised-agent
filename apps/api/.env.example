# Root .env.example - copy to .env at the repo root for docker-compose, or copy the relevant
# values into apps/api/.env for local (non-docker) development. See docs/environment.md.

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

MONGODB_URI=mongodb://localhost:27017/personal_agent
REDIS_URL=redis://localhost:6379

# Generate strong random secrets for these two in any real environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AI_PROVIDER selects the AIModelProvider implementation - see docs/ai-provider.md.
#   mock   - deterministic offline provider, no API key needed (default, used in tests/CI)
#   openai - requires OPENAI_API_KEY
#   ollama - requires a local Ollama server (see docs/future-local-ai.md)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

MOBILE_APP_SCHEME=personalagent
CORS_ORIGINS=*

PUSH_NOTIFICATION_PROVIDER=

# Optional: only needed if you wire up a real web_search provider (see docs/tool-development.md).
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=

LOG_LEVEL=info
