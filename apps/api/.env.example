# Root .env.example - copy to .env at the repo root for docker-compose, or copy the relevant
# values into apps/api/.env for local (non-docker) development. See docs/environment.md.

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

MONGODB_URI=mongodb://localhost:27017/personal_agent
REDIS_URL=redis://localhost:6379

# Generate strong random secrets for these two in any real environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AI_PROVIDER selects the AIModelProvider implementation - see docs/ai-provider.md.
#   mock   - deterministic offline provider, no API key needed (default, used in tests/CI)
#   openai - requires OPENAI_API_KEY
#   ollama - requires a local Ollama server (see docs/future-local-ai.md)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

MOBILE_APP_SCHEME=personalagent
CORS_ORIGINS=*

PUSH_NOTIFICATION_PROVIDER=

# Optional: set WEB_SEARCH_PROVIDER=brave and get a key at https://brave.com/search/api/ to
# enable the web_search tool. Leave blank to keep it honestly returning NOT_CONFIGURED.
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=

# Optional: set RESEND_API_KEY (from https://resend.com/api-keys) to enable real email delivery -
# password-reset emails and the send_message tool (when the recipient is an email address).
# EMAIL_FROM must be a sender Resend allows: their shared onboarding@resend.dev sandbox address
# works with no setup but only delivers to the account's own verified email; verify your own
# domain in Resend to send to arbitrary recipients.
RESEND_API_KEY=
EMAIL_FROM=Personal Agent <onboarding@resend.dev>

# Optional: set YOUTUBE_API_KEY (from console.cloud.google.com, enable "YouTube Data API v3") to
# switch the music_* tools and the mobile Music screen from the local mock catalog to real
# YouTube search + playback via the official embedded player. Takes priority over
# JAMENDO_CLIENT_ID below when both are set (real mainstream/commercial catalog coverage, at the
# cost of a daily quota and occasional per-video embedding restrictions - see
# docs/music-integration.md). Also powers the YouTube provider in the separate, search-only
# Music Search Module - see docs/music-search-module.md.
YOUTUBE_API_KEY=

# Optional: set JAMENDO_CLIENT_ID (free, instant signup at https://devportal.jamendo.com) for
# Jamendo as a fallback/alternative to YouTube - real full-track streaming (not previews), no
# OAuth, no embedding restrictions, but independent/Creative-Commons artists only, never
# mainstream/commercial ones. Used when YOUTUBE_API_KEY is not set. Also powers the Jamendo
# provider in the separate, search-only Music Search Module - see docs/music-search-module.md.
JAMENDO_CLIENT_ID=

LOG_LEVEL=info
